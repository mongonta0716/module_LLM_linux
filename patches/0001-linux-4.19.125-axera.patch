+
+#ifndef _AX_MIPI_DSI_H_
+#define _AX_MIPI_DSI_H_
+
+
+#define  CDNS_MODE_VIDEO_BURST_CLK_RATIO    (2)
+
+struct cdns_dsi_output {
+	struct mipi_dsi_device *dev;
+	struct drm_panel *panel;
+	struct drm_bridge *bridge;
+};
+
