+#define ES8311_ADC_REG19			0x19 /* ADC, alc maxlevel */
+#define ES8311_ADC_REG1A			0x1A /* ADC, alc automute */
+#define ES8311_ADC_REG1B			0x1B /* ADC, alc automute, adc hpf s1 */
