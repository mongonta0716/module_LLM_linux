+#define ES7243l_DIGITAL_VOLUME_11	0xbf + (DIG_VOL_11 * 2)
+#define DIG_VOL_12     0	// DB
+#define ES7243l_DIGITAL_VOLUME_12	0xbf + (DIG_VOL_12 * 2)
+#endif
+
+#if ES7243l_CHANNELS_MAX > 12
