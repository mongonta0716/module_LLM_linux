+static int actt_resume(struct snd_soc_component *component)
+{
+	int ret;
+	struct ax_actt_dev *dev = snd_soc_component_get_drvdata(component);
+
+	ret = clk_prepare_enable(dev->actt_clk);
+	if (ret < 0) {
