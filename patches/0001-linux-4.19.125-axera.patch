+static ssize_t es7210_show(struct device *dev,
+			   struct device_attribute *attr, char *buf)
+{
+	printk("echo flag|reg|val > es7210\n");
+	printk("write star addres=0x90,value=0x3c");
+	printk("count=4:echo 4903c >es7210\n");
+	return 0;
+}
