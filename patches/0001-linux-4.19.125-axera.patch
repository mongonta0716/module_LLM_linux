+#ifndef __AX_LVDS_H
+#define __AX_LVDS_H
+
+#include "ax_drm_drv.h"
+
+enum lvds_pixel_format {
+	LVDS_VESA_24,
+	LVDS_JEIDA_24,
+	LVDS_VESA_18,
+	LVDS_JEIDA_18,
+};
+
+struct ax_lvds {
+	struct drm_encoder encoder;
+	struct drm_connector connector;
