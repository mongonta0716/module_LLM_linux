+	u8 adcdiv;      /* adcclk divider */
+	u8 dacdiv;      /* dacclk divider */
+	u8 fsmode;      /* double speed or single speed, =0, ss, =1, ds */
+	u8 lrck_h;      /* adclrck divider and daclrck divider */
+	u8 lrck_l;
+	u8 bclkdiv;     /* sclk divider */
+	u8 adcosr;      /* adc osr */
+	u8 dacosr;      /* dac osr */
+};
