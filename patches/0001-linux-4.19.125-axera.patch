+			next-level-cache = <&L2_0>;
+			operating-points-v2 = <&cpu_opp_table>;
+			clocks = <&cpu_clk AX620X_CLK_CPU_SEL>;
+		};
+
+		cpu1: cpu@1 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a53", "arm,armv8";
+			reg = <0x1>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0x0 0x23400DC>;
