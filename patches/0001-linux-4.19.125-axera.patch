+module_init(ax_hwinfo_init);
+module_exit(ax_hwinfo_exit);
+MODULE_DESCRIPTION("axera ax_hwinfo driver");
+MODULE_AUTHOR("Axera Inc.");
+MODULE_LICENSE("GPL v2");
