+				 JL2XXX_LED2_LINK1000 | \
+				 JL2XXX_LED2_ACTIVITY)
+
+#define JL1XXX_SUPP_GPIO	(JL1XXX_GPIO_LED0_EN | \
+				 JL1XXX_GPIO_LED0_OUT | \
+				 JL1XXX_GPIO_LED1_EN | \
+				 JL1XXX_GPIO_LED1_OUT)
+
+#define JL1XXX_SUPP_LED_MODE	(JL1XXX_LED0_EEE | \
+				 JL1XXX_LED0_100_ACTIVITY | \
