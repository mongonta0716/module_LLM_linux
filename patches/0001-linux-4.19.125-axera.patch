+	if (mode->dynamic_op == DYNAMIC_ETHTOOL)
+		priv->rgmii.enable |= JL2XXX_RGMII_DYNAMIC_OP_EN;
+	else
+		priv->rgmii.enable &= ~JL2XXX_RGMII_DYNAMIC_OP_EN;
