+static int ax_gzipd_remove(struct platform_device *pdev)
+{
+	free_irq(g_ax_gzipd_dev->irq, NULL);
+	kfree(g_ax_gzipd_dev);
+	misc_deregister(&ax_gzipd_miscdev);
+	return 0;
