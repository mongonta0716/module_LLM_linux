+#define SDHCI_CDNS_HRS06                    0x18		/* eMMC control */
+#define SDHCI_CDNS_HRS06_TUNE_UP            BIT(15)
+#define SDHCI_CDNS_HRS06_TUNE               GENMASK(13, 8)
