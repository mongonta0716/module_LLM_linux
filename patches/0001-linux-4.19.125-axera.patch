+
+#define JL2XXX_SUPP_LED_MODE	(JL2XXX_LED0_LINK10 | \
+				 JL2XXX_LED0_LINK100 | \
+				 JL2XXX_LED0_LINK1000 | \
+				 JL2XXX_LED0_ACTIVITY | \
+				 JL2XXX_LED1_LINK10 | \
+				 JL2XXX_LED1_LINK100 | \
+				 JL2XXX_LED1_LINK1000 | \
