+	} else {
+		periph_timer32_set(handle, 5000000, periph_test, "periph timer32 3.\r\n");
+	}
+#endif
+
+	return 0;
+}
+
+static int axera_periph_timer32_remove(struct platform_device *pdev)
+{
+	return 0;
+}
