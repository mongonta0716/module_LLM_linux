+	0x58000102, 0xB9400041, 0x11000421, 0xB9000041,
+	0xD5033FDF, 0xD503207F, 0xD503201F, 0x14000000,
+	0x0000401C, 0x00000000, 0x00000000, 0x00000000
+};
+static unsigned int pll_state = 0;
+
