+	{AX620X_CLK_I2S_REF0_DIVN, "clk_i2s_ref0_divn", "clk_i2s_ref0_sel", CLK_SET_RATE_PARENT | CLK_IGNORE_UNUSED, 0x14, 0x14, 6, 0, 6, 0, NULL,},
