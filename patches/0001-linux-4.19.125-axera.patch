+	eqos->ephy_shutdown =  devm_reset_control_get_optional(eqos->dev, "ephy_shutdown");
+	if (IS_ERR(eqos->ephy_shutdown)) {
+		dev_err(eqos->dev, "can not get ephy_shutdown!");
