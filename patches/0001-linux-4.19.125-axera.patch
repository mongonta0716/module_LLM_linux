+	{0x14, 0x00},
+	{0x15, 0x00},
+	{0x16, 0x00},
+	{0x17, 0x00},
+	{0x18, 0xf7},
+	{0x19, 0xf7},
+	{0x1a, 0x00},
+	{0x1b, 0xbf},
+	{0x1c, 0xbf},
+	{0x1d, 0xbf},
+	{0x1e, 0xbf},
+	{0x1f, 0x00},
+	{0x20, 0x26},
+	{0x21, 0x26},
+	{0x22, 0x06},
+	{0x23, 0x26},
+	{0x3d, 0x72},
+	{0x3e, 0x10},
+	{0x3f, 0x00},
+	{0x40, 0x80},
+	{0x41, 0x71},
