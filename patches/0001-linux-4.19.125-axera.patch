new file mode 100644
index 000000000..16664b31d
--- /dev/null
+++ b/drivers/hwspinlock/axera_hwspinlock.c
@@ -0,0 +1,158 @@
+// AXERA-License-Identifier: GPL-2.0
+/*
+ * AXERA Hwspinlock driver
