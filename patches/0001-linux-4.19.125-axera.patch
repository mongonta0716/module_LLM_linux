+#define ES7243l_DIGITAL_VOLUME_9		0xbf + (DIG_VOL_9 * 2)
+#define DIG_VOL_10     0	// DB
+#define ES7243l_DIGITAL_VOLUME_10	0xbf + (DIG_VOL_10 * 2)
+#endif
+
+#if ES7243l_CHANNELS_MAX > 10
