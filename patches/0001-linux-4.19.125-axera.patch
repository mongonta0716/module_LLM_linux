+
+	tmpl = container_of(tfm->__crt_alg, ax_cipher_alg_template_s, alg.rng.rng_alg.base);
+	ctx->priv = tmpl->priv;
+	ctx->tmpl = tmpl;
+	ctx->addr_vir = (void *)__get_free_page(GFP_KERNEL);
+	if (ctx->addr_vir == NULL) {
+		CE_LOG_PR(CE_ERR_LEVEL, "__get_free_page failed");
+		return -ENOMEM;
+	}
+	return 0;
+}
