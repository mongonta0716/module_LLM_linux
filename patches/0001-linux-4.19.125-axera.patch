+	dwc3_role_switch.allow_userspace_control = true;
+
+	role_sw = usb_role_switch_register(dwc->dev, &dwc3_role_switch);
+	if (IS_ERR(role_sw))
+		return PTR_ERR(role_sw);
+
+	return 0;
+}
