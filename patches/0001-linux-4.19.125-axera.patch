+	struct reset_control *dphytx_pll_div7_rst_ctrl;
+
+	struct clk *lvds_p_clk;
+	struct clk *dphytx_pll_clk;
+	struct clk *dphytx_pll_div7_clk;
+	struct clk *dphytx_ref_clk;
+	struct clk *comm_dphytx_tlb_clk;
+	int fmt_out;
+};
